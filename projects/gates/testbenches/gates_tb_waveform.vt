`timescale 1ns/1ps

module Gates_tb_waveform;

    reg clk;
    reg A;
    reg B;
    reg S0;
    reg S1;
    reg S2;

    wire Y;
    wire Y_en;
    wire A_en;
    wire B_en;
    wire S0_en;
    wire S1_en;
    wire S2_en;

    gates uut (
        .clk(clk),
        .Y(Y),
        .Y_en(Y_en),
        .A(A),
        .A_en(A_en),
        .B(B),
        .B_en(B_en),
        .S0(S0),
        .S0_en(S0_en),
        .S1(S1),
        .S1_en(S1_en),
        .S2(S2),
        .S2_en(S2_en)
    );

    always #5 clk = ~clk;

    initial begin
        $dumpfile("Gates_tb_waveform.vcd");
        $dumpvars(0, Gates_tb_waveform);

        clk = 1'b0;
        A = 1'b0;
        B = 1'b0;
        S0 = 1'b0;
        S1 = 1'b0;
        S2 = 1'b0;

        $display("Time\tS2S1S0\tA\tB\tY\tOperation");
        $monitor("%0t\t%b%b%b\t%b\t%b\t%b",
                 $time, S2, S1, S0, A, B, Y);

        // AND
        {S2, S1, S0} = 3'b000; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b000; A = 0; B = 1; #10;
        {S2, S1, S0} = 3'b000; A = 1; B = 0; #10;
        {S2, S1, S0} = 3'b000; A = 1; B = 1; #10;

        // OR
        {S2, S1, S0} = 3'b001; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b001; A = 0; B = 1; #10;
        {S2, S1, S0} = 3'b001; A = 1; B = 0; #10;
        {S2, S1, S0} = 3'b001; A = 1; B = 1; #10;

        // XOR
        {S2, S1, S0} = 3'b010; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b010; A = 0; B = 1; #10;
        {S2, S1, S0} = 3'b010; A = 1; B = 0; #10;
        {S2, S1, S0} = 3'b010; A = 1; B = 1; #10;

        // NAND
        {S2, S1, S0} = 3'b011; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b011; A = 0; B = 1; #10;
        {S2, S1, S0} = 3'b011; A = 1; B = 0; #10;
        {S2, S1, S0} = 3'b011; A = 1; B = 1; #10;

        // NOR
        {S2, S1, S0} = 3'b100; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b100; A = 0; B = 1; #10;
        {S2, S1, S0} = 3'b100; A = 1; B = 0; #10;
        {S2, S1, S0} = 3'b100; A = 1; B = 1; #10;

        // XNOR
        {S2, S1, S0} = 3'b101; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b101; A = 0; B = 1; #10;
        {S2, S1, S0} = 3'b101; A = 1; B = 0; #10;
        {S2, S1, S0} = 3'b101; A = 1; B = 1; #10;

        // NOT A
        {S2, S1, S0} = 3'b110; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b110; A = 1; B = 0; #10;

        // NOT B
        {S2, S1, S0} = 3'b111; A = 0; B = 0; #10;
        {S2, S1, S0} = 3'b111; A = 0; B = 1; #10;

        $finish;
    end

endmodule

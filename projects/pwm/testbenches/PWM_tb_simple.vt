`timescale 1ns/1ps

// Simple testbench for PWM.v
// This is useful for basic simulators when you only need to see Y changing.

module PWM_tb_simple;

    reg clk;
    reg S0;
    reg S1;
    reg S2;

    wire clk_en;
    wire S0_en;
    wire S1_en;
    wire S2_en;
    wire Y;
    wire Y_en;

    PWM dut (
        .clk(clk),
        .clk_en(clk_en),

        .S0(S0),
        .S0_en(S0_en),

        .S1(S1),
        .S1_en(S1_en),

        .S2(S2),
        .S2_en(S2_en),

        .Y(Y),
        .Y_en(Y_en)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        $dumpfile("PWM_tb_simple.vcd");
        $dumpvars(0, PWM_tb_simple);

        S0 = 0; S1 = 0; S2 = 0;

        #2560 {S2, S1, S0} = 3'b001;
        #2560 {S2, S1, S0} = 3'b010;
        #2560 {S2, S1, S0} = 3'b011;
        #2560 {S2, S1, S0} = 3'b100;
        #2560 {S2, S1, S0} = 3'b101;
        #2560 $finish;
    end

endmodule
